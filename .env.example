# Public site URL used for canonical links, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend selection. Set to "supabase" in production. Anything else falls back
# to local SQLite, which is fine for local dev but DOES NOT PERSIST on Vercel
# (writes go to /tmp and are wiped on every cold start). The app refuses to
# boot on Vercel without TOPFACULTY_BACKEND=supabase.
TOPFACULTY_BACKEND=supabase

# Supabase project URL and SERVICE ROLE key. Both must be set when
# TOPFACULTY_BACKEND=supabase. Service role bypasses RLS, so keep it
# server-side only — never expose as NEXT_PUBLIC_*.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional. Path to a local SQLite file for dev. Ignored when Supabase is on.
TOPFACULTY_DB_PATH=data/topfaculty.sqlite

# Admin auth. Required to access /admin, /api/admin/*, and to publish /
# archive / delete jobs. Middleware fails closed when either is missing.
# - ADMIN_PASSWORD: chosen by you, shared with whoever should have admin access.
# - ADMIN_AUTH_SECRET: random 32+ char string used to HMAC-sign session
#   cookies. Rotating it invalidates all existing sessions.
ADMIN_PASSWORD=pick-a-strong-password
ADMIN_AUTH_SECRET=use-`openssl rand -hex 32`-or-similar

# Transactional email (Resend). Optional but recommended in prod.
# If RESEND_API_KEY or NOTIFY_EMAIL is unset, all email helpers become
# no-ops so missing config never breaks a request.
# - EMAIL_FROM: needs a Resend-verified domain in production. Until you
#   verify topfaculty.com on Resend you can use "onboarding@resend.dev"
#   (works only for sending to the Resend account email).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFY_EMAIL=ops@your-domain.example
EMAIL_FROM=TopFaculty <noreply@your-domain.example>

# Error monitoring (Sentry). Optional. If unset the SDK initialises to
# a no-op so the build/runtime cost is negligible.
SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
